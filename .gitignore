# Segredos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.build-venv/

# Empacotamento (os .spec são gerados)
installer/*.spec

# Ferramentas
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
.pyright/
# Notas e contexto do agente — nunca vão para o repositório
.workbuddy-ai/

# Dados locais e projetos autorizados
data/*
!data/.gitkeep
projects/*
!projects/.gitkeep

# Sistema
.DS_Store
Thumbs.db

# Servidores de linguagem e caches de ferramentas
.basedpyright/
mypy.ini

# Artefactos soltos na raiz (builds de terceiros, zips de modelos)
/*.zip
/*.7z

# Releases locais: binarios fora do git, a distribuicao publica e o GitHub Releases
releases/**
!releases/README.md
!releases/latest.json
